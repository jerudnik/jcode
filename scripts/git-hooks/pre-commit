#!/usr/bin/env bash
# pre-commit dispatcher for the jcode fork. Keep fast; commit-time gates only.
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"

# Surface contract: PM/tracking must land in notes, not repo docs/.
"$repo_root/scripts/git-hooks/check-pm-surface.sh"

# Keep prompt-loaded repository instructions lean and internally consistent.
python3 "$repo_root/scripts/check_agent_instructions.py"
