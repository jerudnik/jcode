#!/usr/bin/env bash
set -euo pipefail

# Local safety rail for this fork's branch model.
#
# This is a hard fork with a single rail: `main`, anchored at the immutable
# `fork-point` tag. The two former rails, `vendor/upstream` (a mirror of
# upstream master) and `distro/nix` (a packaging layer that existed so upstream
# could be rebased through the stack), both existed only to serve upstream
# tracking and were retired with it. This hook refuses to recreate either,
# because a resurrected rail is silently dead: nothing advances it, and the
# fork-touched gates read the tag instead.

remote_name="${1:-unknown}"
remote_url="${2:-}"

blocked=0

refuse_retired_rail() {
  cat >&2 <<EOF
error: refusing to push $1 to $remote_name ($remote_url)

$1 was retired when this became a hard fork. There is one rail, \`main\`,
and the divergence point is the immutable \`fork-point\` tag (see
docs/BRANCHING.md). Its payload is already contained in main, so
recreating the branch would resurrect something nothing maintains.

EOF
  blocked=1
}

# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per ref on
# stdin; only the remote ref matters here, but all four must be consumed.
# shellcheck disable=SC2034
while read -r local_ref local_sha remote_ref remote_sha; do
  # A deletion sends an all-zero local sha. Deleting a retired rail is exactly
  # what this hook wants to happen, so never stand in its way; only refuse
  # pushes that would create or advance one.
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac

  case "$remote_ref" in
    refs/heads/vendor/upstream) refuse_retired_rail vendor/upstream ;;
    refs/heads/distro/nix)      refuse_retired_rail distro/nix ;;
  esac
done

exit "$blocked"
