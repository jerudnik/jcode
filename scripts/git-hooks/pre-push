#!/usr/bin/env bash
set -euo pipefail

# Local safety rail for this fork's branch model.
#
# The rail order is:
#   fork-point (tag) -> distro/nix -> main
#
# Day-to-day custom Jcode work belongs on main. `distro/nix` is intentionally
# narrow: reusable flake/package/cache/CI glue only. This hook blocks the easy
# accidental push path while keeping an explicit escape hatch for maintenance.

remote_name="${1:-unknown}"
remote_url="${2:-}"

allow_distro="${JCODE_ALLOW_DISTRO_NIX_PUSH:-0}"

blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/vendor/upstream)
      # The vendor rail was retired by the hard fork; the divergence point is
      # the immutable `fork-point` tag. Recreating the branch would resurrect a
      # mirror nothing advances and that the fork-touched gates no longer read.
      cat >&2 <<EOF
error: refusing to push vendor/upstream to $remote_name ($remote_url)

vendor/upstream was retired when this became a hard fork. The divergence point
is the immutable \`fork-point\` tag (see docs/BRANCHING.md). There is no mirror
to maintain, so this branch should not be recreated.

EOF
      blocked=1
      ;;
    refs/heads/distro/nix)
      if [ "$allow_distro" != "1" ]; then
        cat >&2 <<EOF
error: refusing to push distro/nix to $remote_name ($remote_url)

distro/nix is packaging/distribution only. Features, docs, behavior changes,
mobile/web/server work, and normal fork customizations belong on main.

If this is intentional packaging maintenance, rerun with:

  JCODE_ALLOW_DISTRO_NIX_PUSH=1 git push ...

If you accidentally committed feature work on distro/nix, move it instead:

  git switch main
  git cherry-pick <first-bad-commit>^..<last-bad-commit>

EOF
        blocked=1
      fi
      ;;
  esac
done

exit "$blocked"
