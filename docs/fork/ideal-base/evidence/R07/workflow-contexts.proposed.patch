+name: Governance Root
+
+# This workflow is selected by the main ruleset's required-workflow rule from
+# refs/heads/main. It is intentionally independent of candidate scripts.
+on:
+  pull_request:
+    branches: [main]
+
+permissions:
+  contents: read
+
+jobs:
+  governance-root:
+    name: Governance Root
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - uses: actions/checkout@v5
+        with:
+          fetch-depth: 0
+
+      - name: Fetch the trusted main boundary
+        run: git fetch --force --no-tags origin main:refs/remotes/origin/main
+
+      - name: Refuse candidate-controlled governance changes
+        shell: bash
+        run: |
+          set -euo pipefail
+          base="$(git merge-base HEAD refs/remotes/origin/main)"
+          protected=(
+            .github/workflows
+            scripts/required-checks.json
+            scripts/fork-health.sh
+            scripts/ideal_base_railway.py
+            tests/test_ideal_base_railway.py
+            docs/fork/ideal-base/evidence/R07/github-governance.proposed.json
+            docs/fork/ideal-base/evidence/R07/governance-transition.proposed.template.json
+            docs/fork/ideal-base/evidence/R07/governance-transition.workflow.template.yml
+          )
+          if ! git diff --quiet "$base" HEAD -- "${protected[@]}"; then
+            echo "::error::governance-root paths require an explicit ruleset maintenance procedure"
+            git diff --name-only "$base" HEAD -- "${protected[@]}"
+            exit 1
+          fi
